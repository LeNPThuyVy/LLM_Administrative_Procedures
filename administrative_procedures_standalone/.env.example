# ==========================================
# CẤU HÌNH MẪU PHÂN HỆ ĐỘC LẬP THỦ TỤC HÀNH CHÍNH (administrative_procedures_standalone)
# Sao chép file này thành .env và điền thông tin thực tế
# ==========================================

# 1. Cơ sở dữ liệu Ngữ cảnh & Lịch sử hội thoại (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_SSL=require

# 2. Vector Database (Qdrant Cloud hoặc Local fallback)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
DEFAULT_COLLECTION=administrative_procedures

# 3. Đường dẫn thư mục Mô hình (Mặc định ./model trong thư mục standalone)
MODEL_DIR=./model

# 4. Cấu hình Hiệu năng llama-server (Tự động khởi chạy hoặc thủ công)
LLAMA_THREADS=4
LLAMA_PARALLEL=1
LLAMA_CTX_SIZE=4096
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512

# 5. Cơ chế RAG & Quản lý Ngữ cảnh
# SYNTHESIZER_MODE: 'rule' (nhanh, bỏ qua LLM khi đủ dữ liệu), 'llm', 'off'
SYNTHESIZER_MODE=rule
MULTI_INTENT_ENABLED=False
SLIM_CONTEXT=True
ENABLE_LONG_TERM_MEMORY=False
ENABLE_CONVERSATION_SUMMARY=False
HISTORY_STORE_TURNS=10
HISTORY_PROMPT_TURNS=2

# 6. Cấu hình Cổng Dịch vụ (Độc lập: Cổng 8003)
SERVER_HOST=127.0.0.1
STANDALONE_SERVER_PORT=8003
