# ==========================================
# CẤU HÌNH MẪU PHÂN HỆ ĐỘC LẬP THỦ TỤC HÀNH CHÍNH (administrative_procedures_standalone)
# Sao chép file này thành .env và điền thông tin thực tế
# ==========================================

# 1. Cơ sở dữ liệu Ngữ cảnh & Lịch sử hội thoại (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# Đặt true nếu máy chủ PostgreSQL yêu cầu SSL
DB_SSL=false

# 2. Vector Database (Qdrant Cloud hoặc Local fallback)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
DEFAULT_COLLECTION=administrative_procedures

# 3. Đường dẫn thư mục Mô hình (Mặc định ./model trong thư mục standalone)
MODEL_DIR=./model

# 4. Cấu hình Hiệu năng llama-server (Tự động khởi chạy hoặc thủ công)
LLAMA_THREADS=4
LLAMA_PARALLEL=1
LLAMA_CTX_SIZE=4096
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512

# 5. Cơ chế RAG & Quản lý Ngữ cảnh
# SYNTHESIZER_MODE: 'rule' (nhanh, bỏ qua LLM khi đủ dữ liệu), 'llm', 'off'
SYNTHESIZER_MODE=rule
MULTI_INTENT_ENABLED=False
SLIM_CONTEXT=True
ENABLE_LONG_TERM_MEMORY=False
ENABLE_CONVERSATION_SUMMARY=False
HISTORY_STORE_TURNS=10
HISTORY_PROMPT_TURNS=2

# 6. Cấu hình Cổng Dịch vụ (Độc lập: Cổng 8003)
SERVER_HOST=127.0.0.1
STANDALONE_SERVER_PORT=8003

# 7. Ingestion / domain management security
# Bắt buộc đổi giá trị này: giữ nguyên giá trị mẫu thì API quản trị trả 503.
INGESTION_ADMIN_KEY=change-this-to-a-long-random-secret
MAX_UPLOAD_SIZE_MB=20
# Tổng dung lượng sau giải nén của .docx/.xlsx
MAX_UNZIPPED_SIZE_MB=200
MAX_CONCURRENT_INGESTIONS=1

# Giới hạn chat. Đặt CHAT_RATE_LIMIT_PER_MINUTE=0 khi chạy benchmark tải
CHAT_RATE_LIMIT_PER_MINUTE=60
MAX_QUERY_CHARS=4000

# Đặt true khi chạy sau HTTPS để cookie phiên chỉ gửi qua kết nối mã hóa
COOKIE_SECURE=false
